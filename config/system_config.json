{
  "environment": "development",
  "log_level": "INFO",
  "log_dir": "logs",

  "data": {
    "db_path": "data/stocks.duckdb",
    "db_type": "duckdb",
    "enable_cache": true,
    "cache_dir": "data/cache",
    "cache_expiry_hours": 24,
    "price_source": "baostock",
    "sentiment_source": "local",
    "fundamentals_source": "baostock",
    "default_universe": "csi300"
  },

  "router": {
    "sentiment_arb_weight": 0.6,
    "strategy_weight": 0.4,
    "min_conviction": 0.3,
    "min_strength": 30.0,
    "require_agreement": false,
    "max_position_pct": 0.05,
    "max_sector_exposure": 0.25,
    "max_total_exposure": 1.0,
    "max_long_short_ratio": 2.0,
    "position_sizing_method": "signal_strength",
    "base_position_size": 0.02,
    "max_signals_per_run": 50,
    "signal_cooldown_minutes": 60
  },

  "backtest": {
    "initial_capital": 1000000.0,
    "benchmark": "csi300",
    "commission_rate": 0.0003,
    "min_commission": 5.0,
    "slippage_rate": 0.001,
    "stamp_duty": 0.001,
    "fill_model": "next_open",
    "partial_fills": false,
    "price_field": "adj_close",
    "handle_missing_data": "skip",
    "max_position_pct": 0.10,
    "max_drawdown_stop": 0.20,
    "save_trades": true,
    "save_equity_curve": true,
    "save_signals": true,
    "output_dir": "backtest_results"
  },

  "execution": {
    "broker_type": "mock",
    "paper_trading": true,
    "host": "127.0.0.1",
    "port": 11111,
    "max_position_size": 0.05,
    "max_daily_loss": 0.02,
    "max_daily_trades": 50,
    "stop_loss_pct": 0.08,
    "take_profit_pct": 0.15,
    "default_order_type": "MARKET",
    "limit_order_timeout_seconds": 60,
    "allow_partial_fills": true
  },

  "sentiment_arb": {
    "name": "sentiment_arbitrage",
    "version": "1.0.0",
    "signal_frequency": "daily",
    "lookback_days": 252,
    "max_positions": 30,
    "max_sector_concentration": 0.20,
    "kalman_process_noise": 0.01,
    "kalman_measurement_noise": 0.1,
    "z_score_window": 20,
    "z_score_method": "rolling",
    "long_sentiment_threshold": 1.5,
    "long_price_threshold": -0.5,
    "long_dislocation_threshold": 2.0,
    "short_sentiment_threshold": -1.5,
    "short_price_threshold": 0.5,
    "short_dislocation_threshold": -2.0,
    "exit_z_cross": true,
    "exit_time_stop_hours": 48,
    "exit_stop_loss_pct": 0.15,
    "exit_take_profit_pct": 0.20,
    "use_gpu": true,
    "gpu_device": 0
  },

  "contrarian": {
    "name": "contrarian_strategy",
    "version": "1.0.0",
    "signal_frequency": "daily",
    "lookback_days": 252,
    "max_positions": 20,
    "max_sector_concentration": 0.30,
    "sentiment_threshold": 1.5,
    "roc_threshold": 1.0,
    "min_deviation_std": 1.5,
    "undervalued_threshold": 0.10,
    "overvalued_threshold": -0.10,
    "confirmation_periods": 2,
    "stop_loss_pct": 0.08,
    "take_profit_pct": 0.15,
    "sentiment_reversal_threshold": 1.0,
    "valuation_reversal_threshold": 0.05,
    "base_position_size": 0.01,
    "max_position_size": 0.05,
    "sentiment_weight": 0.5,
    "valuation_weight": 0.5
  }
}
