# Broker Configuration
BROKER_TYPE=futu
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
PAPER_TRADING=true

# Risk Configuration
MAX_POSITION_SIZE=10000
MAX_TOTAL_POSITION_VALUE=1000000
MAX_POSITIONS=10
MAX_DAILY_LOSS=5000
STOP_LOSS_PERCENT=5.0

# Order Configuration
DEFAULT_ORDER_TYPE=limit
SLIPPAGE_TOLERANCE=0.01
ORDER_TIMEOUT_SECONDS=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=broker.log
LOG_TO_CONSOLE=true
